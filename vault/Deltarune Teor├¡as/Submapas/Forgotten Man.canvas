		{
			"id": "s_valentin",
			"type": "text",
			"x": 700,
			"y": -209,
			"width": 280,
			"height": 170,
			"color": "3",
			"text": "**Carta de San Valentín (2024)** Su primera aparición real, más de un año antes del Cap.3 — repite casi textualmente su cierre \"lávate la cara y vístete\"."
		},
		{
			"id": "s_islaolvidada",
			"type": "text",
			"x": 0,
			"y": 600,
			"width": 280,
			"height": 170,
			"color": "3",
			"text": "**Isla Olvidada / Ases Voladores** Su reino personal en Mancountry; los Rudinns son copias que Kris coloreó de niño — clave para la teoría del Vessel."
		}
	],
