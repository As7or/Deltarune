{
	"nodes":[
		{"id":"center","type":"text","text":"# Ángel\n👼 Figura central de la Profecía y de la religión de Hometown — según el texto, hay que \"desterrar su Cielo\" para salvar ambos mundos.","x":0,"y":0,"width":380,"height":170,"color":"6"},
