 "nodes": [
  {
   "id": "center",
   "type": "text",
   "text": "# Pippins\n🎲 Darkner con forma de diamante basado en un dado; enemigo común del Mundo TV (Cap.3).",
   "x": -190,
   "y": -105,
   "width": 420,
   "height": 220,
   "color": "6"
  },
  {
   "id": "center-img",
   "type": "file",
