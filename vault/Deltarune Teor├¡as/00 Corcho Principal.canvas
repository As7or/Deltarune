		{
			"id": "g_pink-cap",
			"type": "text",
			"text": "# 🟣 Darkner — **Mad Mew Mew (Pink)**\n**👪 Familia Blook**\n**🐱 Objeto Lightworld: figura Mew Mew**\n**🌑 Reino de las Flores, Cap.5**\n## Quinto portador del Cristal Oscuro, Cap.5.\n[[Mad Mew Mew (Pink)]]",
			"x": -2340,
			"y": 860,
			"width": 340,
			"height": 312,
			"color": "6"
		},
		{
			"id": "g_alvin-cap",
			"type": "text",
			"text": "# 🟢 Lightner — **Alvin**\n**🐢 Tortuga**\n**👪 Familia Boom**\n**⛪ Iglesia**\n## Párroco de Hometown; hijo de Gerson Boom.\n[[Alvin]]",
			"x": 491,
			"y": 1240,
			"width": 380,
			"height": 280,
			"color": "4"
		},
		{
			"id": "g21-cap",
			"type": "text",
			"text": "# 🟢 Lightner — **Asgore**\n**🐐 Cabra**\n**👪 Familia Dreemurr**\n**🌼 Floristería Flower King**\n## Padre de Kris y Asriel. Tritagonista Cap.5.\n[[Asgore]]",
			"x": -2680,
			"y": -3236,
			"width": 340,
			"height": 296,
			"color": "4"
		},
		{
			"id": "g20-cap",
			"type": "text",
			"text": "# 🟢 Lightner — **Toriel**\n**🐐 Cabra**\n**👪 Familia Dreemurr (ex)**\n**🎒 Escuela (profesora)**\n**⛪ Iglesia**\n## Madre de Kris y Asriel, ex-esposa de Asgore.\n[[Toriel]]",
			"x": -1880,
			"y": -3544,
			"width": 340,
			"height": 304,
			"color": "4"
		},
		{
			"id": "g_7flores-cap",
			"type": "text",
			"text": "# 🌱 Planta — **7 Flores de Colores**\n**🌸 Ramo de bodas de Asgore y Toriel**\n## Aqua, Seth, Orange, Green, Yellow y Blue — espejo de las ALMAs de Undertale.\n[[7 Flores de Colores]]",
			"x": -2980,
			"y": -4720,
			"width": 300,
			"height": 340,
			"color": "3"
		},
		{
			"id": "g_gerson-cap",
			"type": "text",
			"text": "# 🟢 Lightner — **Gerson Boom**\n**🐢 Tortuga**\n**👪 Familia Boom**\n**🎓 Escuela (profesor, fallecido)**\n## Lightner fallecido, revivido como el Old Man en el Cap.4.\n[[Gerson Boom]]",
			"x": -1585,
			"y": 1880,
			"width": 340,
			"height": 340,
			"color": "4"
		},
		{
			"id": "g_berdly-cap",
			"type": "text",
			"text": "# 🟢 Lightner — **Berdly**\n**🐦 Ave (cuervo/azulejo)**\n**🎒 Escuela**\n## Compañero de clase; aliado desde el Cap.2.\n[[Berdly]]",
			"x": 440,
			"y": -3201,
			"width": 340,
			"height": 261,
			"color": "4"
		},
		{
			"id": "g_sans-cap",
			"type": "text",
			"text": "# 🟢 Lightner — **Sans**\n**💀 Esqueleto**\n**👪 Hermano de Papyrus**\n**🌭 Vendedor (Festival)**\n## Esqueleto recién llegado a Hometown; personaje de Undertale.\n[[Sans]]",
			"x": -840,
			"y": -4760,
			"width": 340,
			"height": 330,
			"color": "4"
		},
		{
			"id": "g_papyrus-cap",
			"type": "text",
			"text": "# 🟢 Lightner — **Papyrus**\n**💀 Esqueleto**\n**👪 Hermano de Sans**\n## Hermano de Sans; nunca ha aparecido en persona.\n[[Papyrus]]",
			"x": 580,
			"y": -5340,
			"width": 340,
			"height": 270,
			"color": "4"
		},
