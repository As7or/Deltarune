		{
			"id": "g_pink-cap",
			"type": "text",
			"text": "# 🟣 Darkner — **Mad Mew Mew (Pink)**\n**👪 Blook family**\n**🐱 Lightworld object: Mew Mew figure**\n**🌑 Flower Kingdom, Ch.5**\n## Fifth Shadow Crystal bearer, Ch.5.\n[[Mad Mew Mew (Pink)]]",
			"x": -2340,
			"y": 860,
			"width": 340,
			"height": 312,
			"color": "6"
		},
		{
			"id": "g_alvin-cap",
			"type": "text",
			"text": "# 🟢 Lightner — **Alvin**\n**🐢 Turtle**\n**👪 Boom family**\n**⛪ Church**\n## Hometown's parish priest; Gerson Boom's son.\n[[Alvin]]",
			"x": 491,
			"y": 1240,
			"width": 380,
			"height": 280,
			"color": "4"
		},
		{
			"id": "g21-cap",
			"type": "text",
			"text": "# 🟢 Lightner — **Asgore**\n**🐐 Goat**\n**👪 Dreemurr family**\n**🌼 Flower King flower shop**\n## Kris and Asriel's father. Ch.5 tritagonist.\n[[Asgore]]",
			"x": -2680,
			"y": -3236,
			"width": 340,
			"height": 296,
			"color": "4"
		},
		{
			"id": "g20-cap",
			"type": "text",
			"text": "# 🟢 Lightner — **Toriel**\n**🐐 Goat**\n**👪 Dreemurr family (former)**\n**🎒 School (teacher)**\n**⛪ Church**\n## Kris and Asriel's mother, Asgore's ex-wife.\n[[Toriel]]",
			"x": -1880,
			"y": -3544,
			"width": 340,
			"height": 304,
			"color": "4"
		},
		{
			"id": "g_7flores-cap",
			"type": "text",
			"text": "# 🌱 Plant — **7 Colored Flowers**\n**🌸 Asgore and Toriel's wedding bouquet**\n## Aqua, Seth, Orange, Green, Yellow, and Blue — a mirror of the Undertale SOULs.\n[[7 Flores de Colores|7 Colored Flowers]]",
			"x": -2980,
			"y": -4720,
			"width": 300,
			"height": 340,
			"color": "3"
		},
		{
			"id": "g_gerson-cap",
			"type": "text",
			"text": "# 🟢 Lightner — **Gerson Boom**\n**🐢 Turtle**\n**👪 Boom family**\n**🎓 School (teacher, deceased)**\n## Deceased Lightner, revived as the Old Man in Ch.4.\n[[Gerson Boom]]",
			"x": -1585,
			"y": 1880,
			"width": 340,
			"height": 340,
			"color": "4"
		},
		{
			"id": "g_berdly-cap",
			"type": "text",
			"text": "# 🟢 Lightner — **Berdly**\n**🐦 Bird (crow/jay)**\n**🎒 School**\n## Classmate; ally since Ch.2.\n[[Berdly]]",
			"x": 440,
			"y": -3201,
			"width": 340,
			"height": 261,
			"color": "4"
		},
		{
			"id": "g_sans-cap",
			"type": "text",
			"text": "# 🟢 Lightner — **Sans**\n**💀 Skeleton**\n**👪 Papyrus's brother**\n**🌭 Vendor (Festival)**\n## Skeleton newly arrived in Hometown; character from Undertale.\n[[Sans]]",
			"x": -840,
			"y": -4760,
			"width": 340,
			"height": 330,
			"color": "4"
		},
		{
			"id": "g_papyrus-cap",
			"type": "text",
			"text": "# 🟢 Lightner — **Papyrus**\n**💀 Skeleton**\n**👪 Sans's brother**\n## Sans's brother; never appears in person.\n[[Papyrus]]",
			"x": 580,
			"y": -5340,
			"width": 340,
			"height": 270,
			"color": "4"
		},
		{
			"id": "g9-cap",
			"type": "text",
			"text": "# ⚪ Topic — **Prophecy**\n**📜 Object / text**\n## Announces a final sacrifice.\n[[Profecía|Prophecy]]",
