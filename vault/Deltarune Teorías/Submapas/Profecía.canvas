{
	"nodes": [
		{
			"id": "center",
			"type": "text",
			"text": "# Profecía — el texto que lo anuncia todo\n\nTapices del Santuario Oscuro (Cap.4): Fragmentos, duelo con el Knight, sacrificio final.",
			"x": -190,
			"y": -80,
			"width": 400,
			"height": 220,
			"color": "6"
		},
		{
			"id": "s0",
			"type": "text",
			"text": "**Frase de Gaster**\n'Sombras cortando profundo' — casi cita literal suya.",
			"x": -130,
			"y": -538,
			"width": 270,
			"height": 150,
			"color": "1"
		},
		{
			"id": "s1",
			"type": "text",
			"text": "**Roaring Knight**\nEl antagonista que anuncia el propio texto.",
			"x": 320,
			"y": 164,
			"width": 270,
			"height": 150,
			"color": "3"
		},
		{
			"id": "s2",
			"type": "text",
			"text": "**Routes**\nCada ruta oculta reinterpreta el sacrificio.",
			"x": -580,
			"y": 164,
			"width": 270,
			"height": 150,
			"color": "3"
		},
